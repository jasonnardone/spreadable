# Polymarket API Credentials
# Get these from https://polymarket.com/settings/api
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here

# Database Configuration
DB_PASSWORD=choose_secure_password_here
DATABASE_URL=postgresql://spreaduser:${DB_PASSWORD}@localhost:5432/spreadable

# Application Configuration
RUST_ENV=development
RUST_LOG=info,spreadable=debug

# Optional: Override default ports
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432

# Optional: Ollama ML endpoint (for User Story 4)
# OLLAMA_ENDPOINT=http://localhost:11434
